# App
APP_NAME="Phụ Kiện Hạt Dẻ API"
DEBUG=true
SECRET_KEY="change-me-in-production-please-use-openssl-rand-base64-32"

# Database (use postgresql for production)
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pickglx

# Inventory sync (external warehouse management software)
INVENTORY_API_KEY=your-api-key-here
INVENTORY_WEBHOOK_SECRET=your-webhook-secret-here
