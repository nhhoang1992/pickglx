# App
APP_NAME="Phụ Kiện Hạt Dẻ API"
DEBUG=true
SECRET_KEY="change-me-in-production-please-use-openssl-rand-base64-32"

# Database (use postgresql for production)
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pickglx

# Inventory sync (external warehouse management software)
INVENTORY_API_KEY=your-api-key-here
INVENTORY_WEBHOOK_SECRET=your-webhook-secret-here
INVENTORY_EXTERNAL_URL=https://your-warehouse-software.com/api

# Shopee sync
SHOPEE_SHOP_USERNAME=phukienhatde
SHOPEE_SHOP_ID=
SHOPEE_SYNC_ENABLED=true

# MoMo AIO (https://business.momo.vn -> Tích hợp thanh toán)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=https://phukienhatde.vn/checkout/payment-result
MOMO_NOTIFY_URL=https://phukienhatde.vn/api/v1/payments/momo/ipn

# ZaloPay v2 (https://merchant.zalopay.vn -> App quản lý)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=https://phukienhatde.vn/api/v1/payments/zalopay/callback
ZALOPAY_REDIRECT_URL=https://phukienhatde.vn/checkout/payment-result

# Redis (for caching, sessions, background jobs)
REDIS_URL=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
