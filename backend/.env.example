# Shopee sync
SHOPEE_SHOP_USERNAME=phukienhatde
SHOPEE_SHOP_ID=
SHOPEE_SYNC_ENABLED=true

# Redis (for caching, sessions, background jobs)
REDIS_URL=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
