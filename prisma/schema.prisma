// Pickglx — Pickleball club web app
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth/Auth.js) ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  avatarUrl     String?
  passwordHash  String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  clubMemberships      ClubMember[]
  joinRequests         ClubJoinRequest[]    @relation("JoinRequester")
  reviewedRequests     ClubJoinRequest[]    @relation("JoinReviewer")
  createdClubs         Club[]               @relation("ClubCreator")
  createdTournaments   Tournament[]         @relation("TournamentCreator")
  createdSessions      PlaySession[]        @relation("SessionCreator")
  ownedCourts          Court[]              @relation("CourtOwner")
  ticketRegistrations  TicketRegistration[]
  notifications        Notification[]
  sessionParticipants  SessionParticipant[]
  tournamentPlayers1   TournamentParticipant[] @relation("Player1")
  tournamentPlayers2   TournamentParticipant[] @relation("Player2")
  auditLogs            AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Clubs ----------

enum ClubStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MemberRole {
  CAPTAIN
  VICE
  MEMBER
  GUEST
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Club {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  logoUrl     String?
  location    String?
  description String?    @db.Text
  status      ClubStatus @default(PENDING)
  createdById String
  createdBy   User       @relation("ClubCreator", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  members       ClubMember[]
  joinRequests  ClubJoinRequest[]
  tournaments   Tournament[]
  playSessions  PlaySession[]

  @@index([status])
}

model ClubMember {
  id       String        @id @default(cuid())
  clubId   String
  userId   String
  role     MemberRole    @default(MEMBER)
  status   MemberStatus  @default(ACTIVE)
  joinedAt DateTime      @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model ClubJoinRequest {
  id           String            @id @default(cuid())
  clubId       String
  userId       String
  message      String?           @db.Text
  status       JoinRequestStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  club        Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User  @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy  User? @relation("JoinReviewer", fields: [reviewedById], references: [id])

  @@unique([clubId, userId])
  @@index([status])
}

// ---------- Tournaments ----------

enum TournamentFormat {
  ROUND_ROBIN
  KNOCKOUT
  SWISS
  MEXICANO
}

enum TournamentStatus {
  DRAFT
  OPEN
  ONGOING
  FINISHED
}

model Tournament {
  id          String           @id @default(cuid())
  clubId      String?
  club        Club?            @relation(fields: [clubId], references: [id])
  name        String
  slug        String           @unique
  format      TournamentFormat @default(ROUND_ROBIN)
  startDate   DateTime?
  endDate     DateTime?
  location    String?
  fee         Int              @default(0)
  maxPairs    Int?
  status      TournamentStatus @default(DRAFT)
  config      Json?
  createdById String
  createdBy   User             @relation("TournamentCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  participants TournamentParticipant[]
  matches      Match[]

  @@index([status])
}

model TournamentParticipant {
  id              String   @id @default(cuid())
  tournamentId    String
  player1UserId   String?
  player2UserId   String?
  player1Name     String
  player2Name     String
  phone           String?
  paymentStatus   String   @default("UNPAID")
  createdAt       DateTime @default(now())

  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1     User?      @relation("Player1", fields: [player1UserId], references: [id])
  player2     User?      @relation("Player2", fields: [player2UserId], references: [id])

  matchesAsA  Match[] @relation("PairA")
  matchesAsB  Match[] @relation("PairB")

  @@index([tournamentId])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  round        Int
  groupName    String?
  pairAId      String
  pairBId      String
  scoreA       Int?
  scoreB       Int?
  scheduledAt  DateTime?
  court        String?
  status       MatchStatus @default(SCHEDULED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tournament Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pairA      TournamentParticipant @relation("PairA", fields: [pairAId], references: [id])
  pairB      TournamentParticipant @relation("PairB", fields: [pairBId], references: [id])

  @@index([tournamentId, round])
}

// ---------- Money split / Play sessions ----------

enum SplitMethod {
  EQUAL
  BY_MATCH
  BY_HOUR
  CUSTOM
}

model PlaySession {
  id          String      @id @default(cuid())
  clubId      String?
  club        Club?       @relation(fields: [clubId], references: [id])
  name        String
  date        DateTime
  location    String?
  totalCost   Int         @default(0)
  splitMethod SplitMethod @default(EQUAL)
  bankAccount String?
  bankName    String?
  bankHolder  String?
  notes       String?     @db.Text
  createdById String
  createdBy   User        @relation("SessionCreator", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  participants SessionParticipant[]

  @@index([date])
}

model SessionParticipant {
  id             String   @id @default(cuid())
  sessionId      String
  userId         String?
  guestName      String
  guestPhone     String?
  matchesPlayed  Int      @default(0)
  hoursPlayed    Float    @default(0)
  weight         Float    @default(1)
  amountOwed     Int      @default(0)
  paid           Boolean  @default(false)
  proofUrl       String?
  paidAt         DateTime?
  createdAt      DateTime @default(now())

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id])

  @@index([sessionId])
}

// ---------- Courts / Ticket schedule ("Lịch xé vé") ----------

model Court {
  id           String   @id @default(cuid())
  name         String
  address      String?
  ownerUserId  String?
  contact      String?
  bankAccount  String?
  bankName     String?
  bankHolder   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner     User?           @relation("CourtOwner", fields: [ownerUserId], references: [id])
  schedules CourtSchedule[]
}

enum ScheduleStatus {
  OPEN
  CLOSED
  CANCELLED
}

model CourtSchedule {
  id            String         @id @default(cuid())
  courtId       String
  date          DateTime
  startTime     String
  durationHours Float
  pricePerSlot  Int
  totalSlots    Int
  slotsLeft     Int
  status        ScheduleStatus @default(OPEN)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  court         Court                 @relation(fields: [courtId], references: [id], onDelete: Cascade)
  registrations TicketRegistration[]

  @@index([date])
  @@index([courtId])
}

enum TicketStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model TicketRegistration {
  id            String       @id @default(cuid())
  scheduleId    String
  userId        String?
  guestName     String
  guestPhone    String
  slots         Int          @default(1)
  amount        Int
  proofUrl      String?
  status        TicketStatus @default(PENDING)
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime     @default(now())

  schedule CourtSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User?         @relation(fields: [userId], references: [id])

  @@index([scheduleId])
  @@index([status])
}

// ---------- Notifications & audit ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entity      String
  entityId    String
  diff        Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entity, entityId])
}
