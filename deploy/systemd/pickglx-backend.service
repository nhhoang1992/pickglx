[Unit]
Description=Phụ Kiện Hạt Dẻ Backend API (FastAPI)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=pickglx
Group=pickglx
WorkingDirectory=/srv/pickglx/backend
EnvironmentFile=/srv/pickglx/backend/.env
ExecStart=/srv/pickglx/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/pickglx/backend/data /var/log/pickglx

[Install]
WantedBy=multi-user.target
